# Leave unset on Vercel so the app calls same-origin /api (rewritten to the serverless function).
# VITE_API_URL=

# Local: Vite proxies /api → backend (see vite.config.ts). Optional override:
# VITE_API_URL=http://localhost:5055/api

# Only if the API is a separate host (e.g. Render) and not served from this Vercel project:
# VITE_API_URL=https://your-backend.example.com/api
